# ═══════════════════════════════════════════════════════════════════
# Unified Quant Research Platform - Environment Variables
# ═══════════════════════════════════════════════════════════════════
# All settings use local storage by default (SQLite + DiskCache)
# No external services required

# ── Service ────────────────────────────────────────────────────
APP_ENV=local
APP_NAME=Unified Quant Research Platform

# ── Database (SQLite - local file) ─────────────────────────────────────────────────
# Default: SQLite database in local data directory
# Override if needed: sqlite+aiosqlite:///path/to/database.db
DATABASE_URL=sqlite+aiosqlite:///data/research_layer.db

# ── Cache (DiskCache - local directory) ──────────────────────────────────────────
# Default: Local disk cache directory
CACHE_DIR=/data/cache

# ── S3 / MinIO (optional - for production) ──────────────────────────────────────
# Comment out for local-only mode without object storage
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_ARTIFACTS=research-artifacts
# S3_BUCKET_FEATURES=feature-store

# ── MLflow (optional) ─────────────────────────────────────────────────────────────
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=research-layer
# MLFLOW_ARTIFACT_ROOT=s3://research-artifacts/mlflow

# ── Data Layer ─────────────────────────────────────────────────
# When using embedded data layer, set internal mode
# When using external data service, set URL
DATA_SERVICE_URL=http://localhost:8001
DATA_SERVICE_API_KEY=dev-api-key-change-in-production

# Market Data Provider API Keys (optional)
FRED_API_KEY=
NEWS_API_KEY=

# ── Security ───────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ── Events ──────────────────────────────────────────────────────
EVENT_BACKEND=noop
