# ═══════════════════════════════════════════════════════════════════
# Unified Quant Research Platform - Environment Variables
# ═══════════════════════════════════════════════════════════════════

# ── Service ────────────────────────────────────────────────────
APP_ENV=local
APP_NAME=Unified Quant Research Platform

# ── Database ────────────────────────────────────────────────────
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/research_layer
# Railway: Get from Railway PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_layer

# ── Redis ───────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Railway: Get from Upstash Redis or Railway Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── S3 / MinIO ──────────────────────────────────────────────────
# Local: http://localhost:9000
# Railway: Use R2 or external S3-compatible storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ARTIFACTS=research-artifacts
S3_BUCKET_FEATURES=feature-store

# ── MLflow ──────────────────────────────────────────────────────
# Local: http://localhost:5000
# Railway: Deploy MLflow separately or use hosted solution
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=research-layer
MLFLOW_ARTIFACT_ROOT=s3://research-artifacts/mlflow

# ── Data Layer ─────────────────────────────────────────────────
# When using embedded data layer, set internal mode
# When using external data service, set URL
DATA_SERVICE_URL=http://localhost:8001
DATA_SERVICE_API_KEY=dev-api-key-change-in-production

# Market Data Provider API Keys (optional)
FRED_API_KEY=
NEWS_API_KEY=

# ── Security ───────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ── Events ──────────────────────────────────────────────────────
EVENT_BACKEND=noop
